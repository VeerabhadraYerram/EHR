# EHR Platform Environment Configuration

# Database
POSTGRES_USER=ehr_admin
POSTGRES_PASSWORD=ehr_dev_password
POSTGRES_DB=ehr_canonical
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Kafka
KAFKA_BROKER=kafka:9092

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000

# Elasticsearch
ES_HOST=http://elasticsearch:9200

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://keycloak:8080

# HAPI FHIR
HAPI_FHIR_URL=http://hapi-fhir:8080/fhir

# Camunda
CAMUNDA_URL=http://camunda:8080/engine-rest

# Log Level
LOG_LEVEL=INFO


# Patient evidence assistant (server only)
# Server-only configuration. Copy to .env; never use VITE_ prefixes for credentials.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
ASSISTANT_PROVIDER=groq
# Set false to disable all external AI calls and use local record evidence only.
ASSISTANT_ALLOW_EXTERNAL=true
